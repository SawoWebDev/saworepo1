# Only send.php and indxe.php are meant to be requested directly. Block
# direct HTTP access to config/env files (Apache 2.4 with a 2.2 fallback).
<FilesMatch "(^\.env.*|^config\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
