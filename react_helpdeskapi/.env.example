# Copy to .env and fill in real values. .env is gitignored (covered by the
# repo root's bare `.env` rule) — never commit real credentials.

# ---------- Odoo ----------
ODOO_URL=https://erp.sawo.com
ODOO_USERNAME=
ODOO_PASSWORD=
ODOO_API_KEY=

# ---------- SMTP (authenticated relay) ----------
SMTP_HOST=mail.sawo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@sawo.com
SMTP_FROM_NAME=SAWO Sauna Support
# Keep false on the live host — "true" echoes the raw SMTP transcript
# (including the base64 AUTH LOGIN exchange) into the HTTP response body.
SMTP_DEBUG=false

# ---------- Supabase (read-only recipient-override lookup) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------- CORS ----------
# Comma-separated, no trailing slashes.
CONTACT_FORM_ALLOWED_ORIGINS=https://www.sawo.com,https://saworepo1.pages.dev
