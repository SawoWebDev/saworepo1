# Environment variables - NEVER commit these
.env
.env.local
.env.*.local
.env.production
.env.development
frontend/.env
frontend/.env.local
frontend/.env.production
backend/.env
backend/.env.local
frontend/src/.env*

# Dependencies
node_modules/
.pnp
.pnp.js

# Build
build/
dist/
out/

# Wrangler local dev state (Miniflare R2/cache simulation) — never real content
.wrangler/

# i18n extract/inject handoff working files (scripts/i18n/*.js) — transient,
# regenerable from src/i18n/locales/ (the real source of truth) via
# `npm run i18n:extract -- --all` and `npm run i18n:manifest`. See
# frontend/README-i18n.md.
**/frontend/i18n-handoff/

# Whole-site translation master file + its per-locale translated siblings —
# generated by frontend/scripts/i18n/scan-all.js + finalize-master.js,
# regenerable, not a permanent part of the codebase. Handoff artifact for
# sending to an external translation AI; real source of truth stays
# frontend/src/i18n/locales/. Lives at sawo-main/ (a subfolder of this
# .gitignore's own directory), not the repo root — a leading "/" here
# anchors to THIS file's location, so these patterns need "sawo-main/" to
# actually match (a bare "/ENG_translations.json" silently matched nothing
# and these went untracked-but-NOT-ignored for a while before this fix).
sawo-main/ENG_translations.json
sawo-main/ENG_translations_RAW.json
sawo-main/*_translations.json
sawo-main/ENG_0_manifest.json
sawo-main/ENG_[0-9]_*.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Internal documentation — kept local only, not published to GitHub
docs/
sawo-main/docs/

# Supabase Storage archive — the local safety copy taken before the buckets
# were emptied (2026-08-20). ~369 MB of images/PDFs; it is a backup, not
# source, and must never enter git history.
sawo-main/frontend/src/Administrator/Local/data/storage-archive/
