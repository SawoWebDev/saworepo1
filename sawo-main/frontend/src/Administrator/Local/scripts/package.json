{
  "name": "sawo-local-sync",
  "version": "1.0.0",
  "description": "Sync SAWO products from Supabase to local JSON",
  "main": "sync.js",
  "type": "module",
  "scripts": {
    "sync": "node sync.js",
    "sync:rooms": "node sync-sauna-rooms.js",
    "migrate-to-r2": "node migrate-to-r2.js",
    "storage:audit": "node storage-audit.js",
    "storage:archive": "node storage-audit.js --archive",
    "storage:purge": "node storage-audit.js --delete",
    "i18n:product:extract": "node product-i18n.js extract",
    "i18n:product:apply": "node product-i18n.js apply",
    "seo:gsc-sync": "node seo-gsc-sync.js",
    "seo:gsc-backfill": "node seo-gsc-sync.js --backfill",
    "seo:competitor-crawl": "node seo-competitor-crawl.js",
    "seo:serp-check": "node seo-serp-check.js",
    "seo:test": "node --test seo-keyword-intelligence/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@supabase/supabase-js": "^2.38.4",
    "cheerio": "^1.0.0",
    "dotenv": "^16.3.1",
    "googleapis": "^144.0.0",
    "node-fetch": "^3.3.2"
  }
}
